{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: generate-classes",
            "type": "debugpy",
            "request": "launch",
            "module": "codegen.generate_classes",
            "args": [
                "--dfnpath=c:/Users/kraus/Source/Repos/pyphoenix-project/dfn/"
            ]
        },
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "purpose": [
                "debug-test"
            ],
            "justMyCode": false
        },
        {
            "name": "quickstart",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/docs/examples/quickstart.py",
            "console": "integratedTerminal",
            "justMyCode": false,
            "cwd": "${workspaceFolder}/docs/examples"
        }
    ]
}
