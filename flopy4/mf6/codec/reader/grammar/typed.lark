// Newlines are significant here (only inline whitespace and COMMA are
// %ignore'd, not NEWLINE) -- a blanket "%ignore" that swallowed newlines
// couldn't reliably delimit list/record rows or bound a trailing per-line
// remark, since an ignored whitespace run always maximal-munches past a
// bare newline whenever the following line is indented.

integer: SIGNED_INT | INT
double: SIGNED_NUMBER | NUMBER
number: SIGNED_NUMBER | NUMBER
// A block header's period number (or utl-tas's time). Not `number`: its
// reduce state merges with record rows' (see BARE_WORD), so the contextual
// lexer takes a trailing header remark (MAW's legacy `begin period 1
// steady-state`) as BARE_WORD, which the header can't accept.
block_index: SIGNED_NUMBER | NUMBER
string: _token+ _NL
array: (single_array | layered_array)
single_array: [netcdf] readarray
layered_array: layered [netcdf] readarray+
layered: "layered"i [_remark] _NL
netcdf: "netcdf"i
readarray: control [data]
control: constant | internal | external | timearrayseries
// CONSTANT accepts a trailing IPRN flag too, just like INTERNAL/EXTERNAL --
// confirmed against a real fixture ("CONSTANT 1 IPRN 5"), previously only
// modeled on INTERNAL/EXTERNAL.
constant: "constant"i double [iprn] [_remark] _NL
internal: "internal"i [factor] [iprn] [_remark] _NL
external: "open/close"i filename [factor] [binary] [iprn] [_remark] _NL
timearrayseries: "timearrayseries"i word [_remark] _NL
factor: "factor"i double
iprn: "iprn"i integer
binary: "(binary)"i
filename: word
data: (_data_line | NUMBER_LINES)+
_data_line: double+ [_remark] _NL
// begin/end after a record's first token are words, as in basic.lark: MF6
// only takes a line's first word as a block keyword, so later ones are data
// (a boundname `end`, test106's `0.0 ... begin SP 1` remark). `!` keeps the
// filtered-out keyword token so the transformer can return it as a word.
record: token (token | block_kw_word)* _NL | NUMBER_LINES | RECORD_LINES
// A list's row lexed by value, for a list that shares its block with other
// fields (sim-nam's solutiongroup and its MXITER): RECORD_LINES would take
// their lines too.
token_record: token (token | block_kw_word)* _NL | NUMBER_LINES
!block_kw_word: _BEGIN | _END
// Whole tokens only, like the number terminals below. As "begin"i/"end"i
// literals they outrank BARE_WORD (-1) and matched a word's prefix, so a
// boundname like `endpoint` lexed as a dropped `end` and then `point`.
// The generated grammars' block rules import these too. BARE_WORD needn't
// exclude a bare begin/end: these outrank it wherever both are valid, and
// anywhere else it's a word (e.g. a file named `end`).
_BEGIN: /begin(?![^\s,#!])/i
_END: /end(?![^\s,#!])/i
token: number | word
word: BARE_WORD | QUOTED_WORD
// Lower priority than NUMBER/INT/SIGNED_NUMBER/SIGNED_INT (default 0) so a
// pure-digit string always lexes as a number where both could match --
// confirmed necessary, not just tidiness: without it, a state that's
// legitimately reachable from both an `integer+`-repeating rule and an
// unrelated rule ending in a bare `word` (e.g. OC's formatrecord) can get
// its LALR states merged, and the contextual lexer then sometimes resolves
// the ambiguous digit token to BARE_WORD in a state that has no action for
// it at all -- a hard parse failure, not just a wrong parse.
BARE_WORD.-1: /[a-zA-Z0-9'().\/:;<=>?@_~+\[\\-]+/
// A quoted value, which may contain spaces (boundnames, obsnames,
// filenames). Either quote character, like MF6's urword; no escapes.
// Priority 1 so it wins ties against BARE_WORD (-1) here and TOKEN (0) in
// basic.lark, which imports this terminal.
QUOTED_WORD.1: /'[^'\n]*'|"[^"\n]*"/
_token: word | number
// Consecutive lines of only numbers (plus blank and comment-only lines after
// them), as one token, so big files don't take a token per value. A line it
// can't take whole lexes as a `record` or `_data_line` (basic.lark's `line`).
// A `record` that's one of these is all its rows.
NUMBER_LINES.3: /(?:[ \t,]*+[+-]?(?:\d+(?:\.\d*)?|\.\d+)(?:[eEdD][+-]?\d+)?(?:[ \t,]++[+-]?(?:\d+(?:\.\d*)?|\.\d+)(?:[eEdD][+-]?\d+)?)*+[ \t,]*+\r?\n(?:[ \t,]*+(?:[#!][^\n]*+)?\r?\n)*+)++/
// Consecutive lines of plain words and numbers (plus blank and
// comment-only lines after them), as one token, like NUMBER_LINES for rows
// that aren't only numbers (SFR's `1 inflow 0.0`). A word is a BARE_WORD
// without a quote, so a line with a quoted word, a trailing comment or a
// `begin`/`end`/`open/close` first lexes as a `record`. Below NUMBER_LINES,
// which takes a run of only numbers first (so it can be read by column).
RECORD_LINES.1: /(?:[ \t,]*+(?!(?i:begin|end|open\/close)(?![^\s,#!]))[a-zA-Z0-9().\/:;<=>?@_~+\[\\-]++(?:[ \t,]++[a-zA-Z0-9().\/:;<=>?@_~+\[\\-]++)*+[ \t,]*+\r?\n(?:[ \t,]*+(?:[#!][^\n]*+)?\r?\n)*+)++/
// Excludes "," (not just whitespace) so a remark can never out-length a
// COMMA-separated data run with no surrounding spaces (confirmed against a
// real fixture: TDIS's "1.00000000,1,1.00000000" -- maximal munch always
// prefers the longer match regardless of priority, so an unbounded \S+
// remark starting right at the first comma would swallow the remaining
// comma-joined values whole instead of letting COMMA (%ignore'd) separate
// them). A remark containing commas (e.g. a "PERLEN,NSTP,TSMULT" label)
// still works: it just lexes as several _REMARK tokens joined by ignored
// commas, and `_remark: _REMARK+` accepts any run of them.
_REMARK.-1: /[^\s,]+/
_remark: _REMARK+
open_close_redirect: "open/close"i filename [_remark] _NL

%import common.NEWLINE -> _NL
%import common.WS_INLINE
%import common.CNAME
%import common.SH_COMMENT

COMMA: ","
%ignore WS_INLINE
%ignore SH_COMMENT
// mf6 also takes `!` for a comment
BANG_COMMENT: /![^\n]*/
%ignore BANG_COMMENT
%ignore COMMA

// common's number terminals, but only as a whole token. Otherwise a token
// that starts like a number lexes as a number followed by a word, e.g. an
// ISO datetime `1997-07-16T19:20:30` as `1997`, `-07`, `-16` and
// `T19:20:30`. A token ends at whitespace, a comma, or a comment (`#` or
// `!`), so `5!note` is the number 5 and then a comment.
INT: /\d+(?![^\s,#!])/
SIGNED_INT: /[+-]\d+(?![^\s,#!])/
NUMBER: /(\d+(\.\d*)?|\.\d+)([eE][+-]?\d+)?(?![^\s,#!])/
SIGNED_NUMBER: /[+-](\d+(\.\d*)?|\.\d+)([eE][+-]?\d+)?(?![^\s,#!])/
