start: [_NL*] (block [_NL*])*
block: "begin"i block_name _NL _list "end"i block_name [_NL+]
block_name: CNAME [INT]
_list: line*
line: item* _NL+
item: word | NUMBER
word: /[a-zA-Z0-9'().\/:;<=>?@_~+\[\\-]+/
COMMA: ","

%import common.NEWLINE -> _NL
%import common.WS_INLINE
%import common.CNAME
%import common.WORD
%import common.NUMBER
%import common.INT
%import common.SH_COMMENT
%import common._STRING_INNER

%ignore WS_INLINE
%ignore SH_COMMENT
%ignore COMMA
