{# Field rendering macros.

   A field whose value rule already consumes its own trailing line ending
   internally (array -- via constant/internal/external/data's own `_NL`;
   string -- via its own `_NL`) must NOT get a second one appended here, or
   the grammar would require two newlines where the real file only has one.
   Every other value type doesn't self-terminate, so the *top-level*
   variant of its macro appends `[_remark] _NL`. A field referenced inline
   from its parent's own single-line rule (a nested record/union child)
   must never append a line ending itself -- that's what `nested_record`/
   `nested_union` are for, as opposed to `record_field`/`union_field`. #}

{% macro record_field(field_name, field) -%}
{{ nested_record(field_name, field) }} [_remark] _NL
{%- endmacro %}

{% macro nested_record(field_name, field) -%}
{{ field_name|to_rule_name }}: {% for child_name, child in field.children.items() -%}
{%- set child_type = child|record_child_type -%}
{%- if child.type == 'keyword' and child.optional -%}
{# A record's optional Keyword child (e.g. NPF's xt3doptions -- "xt3d rhs",
   where "rhs" is `optional true`) is routinely omitted in real files --
   confirmed against a real fixture ("XT3D" alone, no trailing "RHS"). This
   was previously always rendered mandatory regardless of `.optional`. #}
["{{ child.name }}"i]
{%- elif child.type == 'keyword' -%}
"{{ child.name }}"i
{%- elif child.type == 'union' or child.type == 'record' -%}
{{ child_name|to_rule_name }}
{%- elif child.type == 'file' -%}
"file{{ child.direction }}"i word
{%- elif child.tagged and child.optional -%}
{# A `tagged true` scalar child (e.g. formatrecord's columns/width/digits,
   confirmed against the real DFN) is preceded by its own keyword label
   in real files ("COLUMNS 15", not a bare "15") -- unlike an untagged
   scalar (formatrecord's own `format`, e.g. "GENERAL"). `optional true`
   (confirmed for columns/width/digits, and for IMS's `rclose_option`
   below) means real files routinely omit it entirely -- most fixtures
   checked for sln-ims's rcloserecord never write the trailing STRICT/
   L2NORM_RCLOSE/RELATIVE_RCLOSE option at all. #}
["{{ child.name }}"i {{ child_type }}]
{%- elif child.tagged -%}
"{{ child.name }}"i {{ child_type }}
{%- elif child.optional -%}
[{{ child_type }}]
{%- else -%}
{{ child_type }}
{%- endif -%}
{%- if not loop.last %} {% endif -%}
{%- endfor %}
{%- endmacro %}

{% macro union_field(field_name, field) -%}
{# The alternation must be parenthesized before appending `[_remark] _NL` --
   `|` binds looser than concatenation, so an unparenthesized "A | B | C
   [_remark] _NL" only requires the line ending after the *last* arm. A
   `tagged true` union (e.g. NPF's alternative_cell_averaging, confirmed via
   valid_as_union) additionally needs its own field-name keyword prefixed --
   real files write "ALTERNATIVE_CELL_AVERAGING LOGARITHMIC", not a bare
   "LOGARITHMIC" -- unlike an untagged keystring (e.g. ocsetting's ALL/
   FIRST/LAST), where the chosen value's own keyword is the whole field. #}
{{ field_name|to_rule_name }}: {% if field.tagged %}"{{ field.name }}"i ({% endif -%}
{%- for child_name, child in field.children.items() -%}
{{ field_name|to_rule_name }}_{{ child_name|to_rule_name }}
{%- if not loop.last %} | {% endif -%}
{%- endfor -%}
{%- if field.tagged %}){% endif %} [_remark] _NL

{% for child_name, child in field.children.items() -%}
{{ field_name|to_rule_name }}_{{ child_name|to_rule_name }}: {% if child.type == 'keyword' -%}
"{{ child.name }}"i
{%- elif child.type == 'array' -%}
"{{ child.name }}"i {{ child|field_type }}
{%- else -%}
"{{ child.name }}"i {{ child.type }}
{%- endif %}

{% endfor -%}
{%- endmacro %}

{% macro simple_field(field_name, field, field_type) -%}
{%- if field_type == 'array' and field.name|lower == 'aux' -%}
{# The DFN's "aux" field is a documentation placeholder for READASARRAYS-
   style packages (e.g. RCHA) -- real files write the *user-declared*
   AUXILIARY variable name as the field's own keyword instead of a literal
   "AUX" (confirmed against a real fixture: AUXILIARY MYRCHMULT in OPTIONS,
   then a bare "MYRCHMULT" array field in PERIOD, never "AUX"). That name is
   only known at options-parse time, not grammar-generation time, so accept
   any word here rather than a fixed literal -- still bound to the "aux"
   rule name so the transformer's field lookup keeps working. #}
{{ field_name|to_rule_name }}: word [_remark] [_NL] {{ field_type }}
{%- elif field_type == 'array' -%}
{# Real files write an array field's name alone on its own line about as
   often as on the same line as its CONSTANT/INTERNAL/OPEN-CLOSE value
   (e.g. STO's "ss" -- confirmed directly against a real fixture) -- the
   line break between name and value is optional either way. #}
{{ field_name|to_rule_name }}: "{{ field.name }}"i [_remark] [_NL] {{ field_type }}
{%- else -%}
{{ field_name|to_rule_name }}: "{{ field.name }}"i {{ field_type }}
{%- if field_type != 'string' %} [_remark] _NL{% endif -%}
{%- endif -%}
{%- endmacro %}

{% macro file_field(field_name, field) -%}
{{ field_name|to_rule_name }}: "{{ field.name }}"i "file{{ field.direction }}"i word [_remark] _NL
{%- endmacro %}

{% macro nested_union(child_name, child) -%}
{{ child_name|to_rule_name }}: {% for opt_name, opt in child.children.items() -%}
{{ child_name|to_rule_name }}_{{ opt_name|to_rule_name }}
{%- if not loop.last %} | {% endif -%}
{%- endfor %}

{% for opt_name, opt in child.children.items() -%}
{{ child_name|to_rule_name }}_{{ opt_name|to_rule_name }}: {% if opt.type == 'keyword' -%}
"{{ opt.name }}"i
{%- elif opt.type == 'array' -%}
"{{ opt.name }}"i {{ opt|field_type }}
{%- else -%}
"{{ opt.name }}"i {{ opt.type }}
{%- endif %}

{% endfor -%}
{%- endmacro %}

{# Block definition macro. Newlines are significant (see the header note in
   component.lark.jinja), so the BEGIN line's own line ending must be
   consumed explicitly before the block's fields start, and a run of blank
   lines before END is tolerated defensively (mirrors basic.lark). #}
{%- macro block_def(block_name, has_index) -%}
{%- if has_index -%}
{# Real corpus files overwhelmingly close an indexed block as bare
   "END <name>", not repeating the index -- confirmed ~91% (1503/1651)
   across a random corpus sample. The trailing index is still accepted
   when present (the remaining ~9%). #}
{{ block_name }}_block: "begin"i "{{ block_name }}"i block_index [_remark] _NL _NL* {{ block_name }}_fields _NL* "end"i "{{ block_name }}"i [block_index]
{%- else -%}
{{ block_name }}_block: "begin"i "{{ block_name }}"i [_remark] _NL _NL* {{ block_name }}_fields _NL* "end"i "{{ block_name }}"i
{%- endif -%}
{%- endmacro %}

{# Field list macro. Each field alternative is followed by `_NL*` to
   tolerate a blank or comment-only line (SH_COMMENT is ignored, but its
   own trailing line ending still needs consuming) between two fields --
   confirmed needed against real fixtures with a stray "#" comment line
   between GRIDDATA array fields.

   Any block's entire content may also be redirected to an external file
   via a bare "OPEN/CLOSE <file>" line in place of its usual fields --
   confirmed against real fixtures for both a PERIOD block (an OC package)
   and a DIMENSIONS block (a DISV package). Actually reading that file's
   rows is out of this pass's scope (same as griddata/array-field OPEN/
   CLOSE), but per the plan's own carve-out, an unknown-but-syntactically-
   plausible line must not hard-fail the whole block's parse -- so the
   alternative is accepted structurally here and simply dropped by the
   transformer (see `__default__`'s tuple-only field collection), same
   disposition as the AUXILIARY dynamic-name fallback. #}
{%- macro field_list(block_name, fields, recarray_name) -%}
{%- set alts = fields|map('to_rule_name')|list -%}
{%- if recarray_name -%}
{%- set _ = alts.append(recarray_name) -%}
{%- endif -%}
{%- set _ = alts.append('open_close_redirect') -%}
{{ block_name }}_fields: (({{ alts|join(' | ') }}) _NL*)*
{%- endmacro %}
