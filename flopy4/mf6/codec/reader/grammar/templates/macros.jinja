{# Field rendering macros.

   A field whose value rule already consumes its own trailing line ending
   internally (array -- via constant/internal/external/data's own `_NL`;
   string -- via its own `_NL`) must NOT get a second one appended here, or
   the grammar would require two newlines where the real file only has one.
   Every other value type doesn't self-terminate, so the *top-level*
   variant of its macro appends `[_remark] _NL`. A field referenced inline
   from its parent's own single-line rule (a nested record/union child)
   must never append a line ending itself -- that's what `nested_record`/
   `nested_union` are for, as opposed to `record_field`/`union_field`. #}

{% macro record_field(field_name, field, name) -%}
{{ nested_record(field_name, field, name) }} [_remark] _NL
{{- record_parts(field_name, field) }}
{%- endmacro %}

{# A record names each of its parts with a rule of its own (see
   grammar/names.py), so the parse tree shows which part each value is,
   and whether an optional keyword was given (an anonymous literal is
   dropped from it). A required keyword is just a literal. #}
{% macro record_parts(field_name, field) -%}
{% for child_name, child in field.children.items() if child.type not in ('union', 'record') and not (child.type == 'keyword' and not child.optional) %}

{{ rule(field_name, child_name, tags=[part_tag(child)]) }}: {{ part_body(child) }}
{%- endfor %}
{%- endmacro %}

{# A record part's own tokens. A `tagged true` scalar part (e.g.
   formatrecord's columns/width/digits, confirmed against the real DFN) is
   preceded by its own keyword label in real files ("COLUMNS 15", not a
   bare "15") -- unlike an untagged scalar (formatrecord's own `format`,
   e.g. "GENERAL"). #}
{% macro part_body(child) -%}
{%- set child_type = child|record_child_type -%}
{%- if child.type == 'keyword' -%}
{{ child|keyword_literal }}
{%- elif child.type == 'file' -%}
"file{{ child.direction }}"i word
{%- elif child.tagged -%}
"{{ child.name }}"i {{ child_type }}
{%- else -%}
{{ child_type }}
{%- endif -%}
{%- endmacro %}

{% macro nested_record(field_name, field, name) -%}
{{ name }}: {% for child_name, child in field.children.items() -%}
{%- if child.type == 'keyword' and not child.optional -%}
{{ child|keyword_literal }}
{%- elif child.type == 'union' -%}
{{ rule(child_name, tags=['union']) }}
{%- elif child.type == 'record' -%}
{{ rule(child_name, tags=['rec']) }}
{%- elif child.optional and child.type != 'file' -%}
{# A record's optional keyword part (e.g. NPF's xt3doptions -- "xt3d
   rhs", where "rhs" is `optional true`) is routinely omitted in real
   files -- confirmed against a real fixture ("XT3D" alone, no trailing
   "RHS"). So is an optional tagged scalar part: most fixtures checked for
   sln-ims's rcloserecord never write the trailing STRICT/L2NORM_RCLOSE/
   RELATIVE_RCLOSE option at all. #}
[{{ rule(field_name, child_name, tags=[part_tag(child)]) }}]
{%- else -%}
{{ rule(field_name, child_name, tags=[part_tag(child)]) }}
{%- endif -%}
{%- if not loop.last %} {% endif -%}
{%- endfor %}
{%- endmacro %}

{# A block's record header (OBS's "CONTINUOUS FILEOUT <file> [BINARY]")
   keeps all its tokens (`!`): the transformer keys the block by the
   header as written. An optional keyword is a rule of its own, so the
   tree shows whether it was given. #}
{% macro header_record(field_name, field) -%}
!{{ rule(field_name, tags=['hdr']) }}: {% for child_name, child in field.children.items() -%}
{%- set child_type = child|record_child_type -%}
{%- if child.type == 'keyword' and child.optional -%}
[{{ rule(field_name, child_name, tags=['kw']) }}]
{%- elif child.type == 'keyword' -%}
{{ child|keyword_literal }}
{%- elif child.type == 'file' -%}
"file{{ child.direction }}"i word
{%- elif child.tagged and child.optional -%}
["{{ child.name }}"i {{ child_type }}]
{%- elif child.tagged -%}
"{{ child.name }}"i {{ child_type }}
{%- elif child.optional -%}
[{{ child_type }}]
{%- else -%}
{{ child_type }}
{%- endif -%}
{%- if not loop.last %} {% endif -%}
{%- endfor %}
{% for child_name, child in field.children.items() if child.type == 'keyword' and child.optional %}

{{ rule(field_name, child_name, tags=['kw']) }}: {{ child|keyword_literal }}
{%- endfor %}
{%- endmacro %}

{# A union arm's own tokens. A keyword arm keeps its token (`!`), whose
   text is the arm read. #}
{% macro union_arms(field_name, field) -%}
{% for child_name, child in field.children.items() -%}
{%- if child.type == 'keyword' -%}
!{{ rule(field_name, child_name, tags=['kw']) }}: {{ child|keyword_literal }}
{%- elif child.type == 'array' -%}
{{ rule(field_name, child_name, tags=['val']) }}: {% if child.tagged %}"{{ child.name }}"i {% endif %}{{ child|field_type }}
{%- else -%}
{{ rule(field_name, child_name, tags=['val']) }}: {% if child.tagged %}"{{ child.name }}"i {% endif %}{{ child.type }}
{%- endif %}

{% endfor -%}
{%- endmacro %}

{% macro union_alternation(field_name, field) -%}
{%- for child_name, child in field.children.items() -%}
{{ rule(field_name, child_name, tags=['kw' if child.type == 'keyword' else 'val']) }}
{%- if not loop.last %} | {% endif -%}
{%- endfor -%}
{%- endmacro %}

{% macro union_field(field_name, field, name, tagged=false) -%}
{# The alternation must be parenthesized before appending `[_remark] _NL` --
   `|` binds looser than concatenation, so an unparenthesized "A | B | C
   [_remark] _NL" only requires the line ending after the *last* arm. A
   tagged `valid` scalar made a union (`tagged`, e.g. NPF's
   alternative_cell_averaging, via valid_as_union) also begins with its
   own name -- real files write
   "ALTERNATIVE_CELL_AVERAGING LOGARITHMIC", not a bare "LOGARITHMIC" --
   unlike a union of keywords (e.g. ocsetting's ALL/FIRST/LAST), where the
   chosen value's own keyword is the whole field. #}
{{ name }}: {% if tagged %}"{{ field.name }}"i {% endif %}({{ union_alternation(field_name, field) }}) [_remark] _NL

{{ union_arms(field_name, field) }}
{%- endmacro %}

{% macro simple_field(name, field, field_type) -%}
{%- if field_type == 'array' and not field.tagged -%}
{{ name }}: {{ field_type }}
{%- elif field_type == 'array' -%}
{# Real files write an array field's name alone on its own line about as
   often as on the same line as its CONSTANT/INTERNAL/OPEN-CLOSE value
   (e.g. STO's "ss" -- confirmed directly against a real fixture) -- the
   line break between name and value is optional either way. #}
{{ name }}: "{{ field.name }}"i [_remark] [_NL] {{ field_type }}
{%- else -%}
{{ name }}: {{ field|keyword_literal }} {{ field_type }}
{%- if field_type != 'string' %} [_remark] _NL{% endif -%}
{%- endif -%}
{%- endmacro %}

{% macro dynamically_named_array_field(name) -%}
{# The name isn't known until the file is read (it's one of the AUXILIARY
   variables), so accept any word. The array's own rule ends the line. #}
{{ name }}: word [_remark] [_NL] array
{%- endmacro %}

{% macro file_field(name, field) -%}
{# A name-file entry (mode_keyword false, e.g. sim-nam's "TDIS6 <file>")
   has no FILEIN/FILEOUT. #}
{{ name }}: "{{ field.name }}"i {% if field.mode_keyword %}"file{{ field.direction }}"i {% endif %}word [_remark] _NL
{%- endmacro %}

{% macro nested_union(child_name, child) -%}
{{ rule(child_name, tags=['union']) }}: {{ union_alternation(child_name, child) }}

{{ union_arms(child_name, child) }}
{%- endmacro %}

{# Block definition macro. Newlines are significant (see the header note in
   component.lark.jinja), so the BEGIN line's own line ending must be
   consumed explicitly before the block's fields start, and blank
   lines before END is tolerated defensively (mirrors basic.lark). #}
{%- macro block_def(block_name, has_index, header=none, index_rule='block_index') -%}
{%- set block_rule = rule(block_name, tags=['block']) -%}
{%- set fields_rule = rule(block_name, tags=['fields']) -%}
{%- if header -%}
{# A record header (OBS's "CONTINUOUS FILEOUT <file> [BINARY]"), which
   the END line may repeat. #}
{%- set header_rule = rule(header, tags=['hdr']) -%}
{{ block_rule }}: _BEGIN "{{ block_name }}"i {{ header_rule }} [_remark] _NL _NL* {{ fields_rule }} _NL* _END "{{ block_name }}"i [{{ header_rule }}]
{%- elif has_index -%}
{# Real corpus files overwhelmingly close an indexed block as bare
   "END <name>", not repeating the index -- confirmed ~91% (1503/1651)
   across a random corpus sample. The trailing index is still accepted
   when present (the remaining ~9%). #}
{{ block_rule }}: _BEGIN "{{ block_name }}"i {{ index_rule }} [_remark] _NL _NL* {{ fields_rule }} _NL* _END "{{ block_name }}"i [{{ index_rule }}]
{%- else -%}
{{ block_rule }}: _BEGIN "{{ block_name }}"i [_remark] _NL _NL* {{ fields_rule }} _NL* _END "{{ block_name }}"i
{%- endif -%}
{%- endmacro %}

{# Field list macro. Each field alternative is followed by `_NL*` to
   tolerate a blank or comment-only line (SH_COMMENT is ignored, but its
   own trailing line ending still needs consuming) between two fields --
   confirmed needed against real fixtures with a stray "#" comment line
   between GRIDDATA array fields.

   Any block's entire content may also be redirected to an external file
   via a bare "OPEN/CLOSE <file>" line in place of its usual fields --
   confirmed against real fixtures for both a PERIOD block (an OC package)
   and a DIMENSIONS block (a DISV package). Actually reading that file's
   rows is out of this pass's scope (same as griddata/array-field OPEN/
   CLOSE), but per the plan's own carve-out, an unknown-but-syntactically-
   plausible line must not hard-fail the whole block's parse -- so the
   alternative is accepted structurally here and simply dropped by the
   transformer (see `__default__`'s tuple-only field collection), same
   disposition as the AUXILIARY dynamic-name fallback. #}
{%- macro field_list(block_name, fields, rules, recarray_name, redirect=true) -%}
{%- set alts = [] -%}
{%- for f in fields -%}
{%- set _ = alts.append(rules[f]) -%}
{%- endfor -%}
{%- if recarray_name -%}
{%- set _ = alts.append(recarray_name) -%}
{%- endif -%}
{%- if redirect -%}
{%- set _ = alts.append('open_close_redirect') -%}
{%- endif -%}
{{ rule(block_name, tags=['fields']) }}: (({{ alts|join(' | ') }}) _NL*)*
{%- endmacro %}
