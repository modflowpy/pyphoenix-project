{% import 'macros.jinja' as m %}
// Auto-generated grammar for MF6 {{ name|upper }}

// Newlines are significant here (only inline whitespace is ignored) -- see
// typed.lark's own header note for why: a blanket "%ignore" that swallows
// newlines can't reliably delimit list/record rows or bound a trailing
// per-line remark, since an ignored whitespace run always maximal-munches
// past a bare newline whenever the following line is indented.
%import typed.integer -> integer
%import typed.double -> double
%import typed.number -> number
%import typed.string -> string
%import typed.word -> word
%import typed.array -> array
%import typed.record -> record
%import typed.open_close_redirect -> open_close_redirect
%import typed._NL -> _NL
%import typed._remark -> _remark
%import typed.COMMA -> COMMA
%import common.WS_INLINE
%import common.SH_COMMENT

%ignore WS_INLINE
%ignore SH_COMMENT
%ignore COMMA

{% set ns = namespace(alts=[]) -%}
{% for block in blocks -%}
{% set ns.alts = ns.alts + [block.name ~ '_block'] -%}
{% endfor -%}
{% set block_alts = ns.alts|join(' | ') -%}
{# A `block:` rule with no alternatives (a component with zero blocks, e.g.
   exg-gwfgwt.dfn -- confirmed genuinely empty, just a header comment, no
   input file content of its own) would be nullable, and a nullable rule
   inside `start`'s own `*` repetition creates a Reduce/Reduce collision at
   grammar-construction time (the LALR automaton can't tell an empty
   `block` match apart from `start` simply being done). A plain-text
   literal that can never occur in real input keeps the rule well-formed
   but non-nullable (no escape sequences here -- an embedded raw NUL byte
   from a `\x00`-style escape trips Lark's own literal-eval). #}
start: _NL* (block _NL*)*
block: {{ block_alts if blocks else '"NO_BLOCKS_DEFINED_FOR_THIS_COMPONENT"' }}

{% for block in blocks -%}
{{ m.block_def(block.name, block.has_index) }}
{% endfor -%}
{% if blocks|selectattr('has_index')|list -%}
block_index: integer
{% endif -%}
{% for block in blocks -%}
{% if block.recarrays -%}
{% set recarray_name = block.recarrays[0].name -%}
{{ m.field_list(block.name, block.standalone_fields, recarray_name) }}
{% else -%}
{{ m.field_list(block.name, block.standalone_fields, none) }}
{% endif -%}
{% endfor -%}
{% set generated_rules = [] -%}
{% for block in blocks -%}
{% for field_name in block.standalone_fields -%}
{% if field_name not in generated_rules -%}
{% set field = fields[field_name] -%}
{% set field_type = field_type_overrides.get(field_name) or (field|field_type) -%}
{% if field.type == 'record' and field.children is not none -%}
{{ m.record_field(field_name, field) }}
{% elif field.type == 'union' and field.children is not none -%}
{{ m.union_field(field_name, field) }}
{% elif field.type == 'file' -%}
{{ m.file_field(field_name, field) }}
{% else -%}
{{ m.simple_field(field_name, field, field_type) }}
{% endif -%}
{% set _ = generated_rules.append(field_name) -%}
{% endif -%}
{% endfor -%}
{% endfor -%}
{% set unions_generated = [] -%}
{% for field_name in generated_rules -%}
{% set field = fields[field_name] -%}
{% if field.type == 'record' and field.children is not none -%}
{% for child_name, child in field.children.items() -%}
{% if child.type == 'union' and child_name not in unions_generated -%}
{{ m.nested_union(child_name, child) }}
{% set _ = unions_generated.append(child_name) -%}
{% elif child.type == 'record' and child.children is not none and child_name not in unions_generated -%}
{{ m.nested_record(child_name, child) }}
{% set _ = unions_generated.append(child_name) -%}
{% endif -%}
{% endfor -%}
{% endif -%}
{% endfor -%}
{% for block in blocks -%}
{% for recarray in block.recarrays -%}
{{ recarray.name }}: record+
{% endfor -%}
{% endfor -%}
