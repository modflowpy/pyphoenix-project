// Auto-generated grammar for MF6 GWF-EVTA
%import typed.integer -> integer
%import typed.double -> double
%import typed.string -> string
%import typed.list -> list
%import typed.array -> array
%import common.WS
%import common.SH_COMMENT

%ignore WS
%ignore SH_COMMENT

start: block*
block: options_block | period_block
options_block: "begin"i "options"i options_fields "end"i "options"i
period_block: "begin"i "period"i period_fields "end"i "period"i
options_fields: (readasarrays | fixed_cell | auxiliary | auxmultname | print_input | print_flows | save_flows | tas_filerecord | obs_filerecord | export_array_netcdf)*
period_fields: (stress_period_data)*
readasarrays: "readasarrays"i 
fixed_cell: "fixed_cell"i 
auxiliary: "auxiliary"i array
auxmultname: "auxmultname"i string
print_input: "print_input"i 
print_flows: "print_flows"i 
save_flows: "save_flows"i 
tas_filerecord: "tas6"i "filein"i string
obs_filerecord: "filein"i "obs6"i string
export_array_netcdf: "export_array_netcdf"i 
stress_period_data: cellid ievt surface rate depth aux
cellid: integer+
ievt: integer
surface: double
rate: double
depth: double
aux: double
