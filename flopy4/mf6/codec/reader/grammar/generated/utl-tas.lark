// Auto-generated grammar for MF6 UTL-TAS -- see typed.lark's own
// header note for why newlines are significant here.
%import typed.integer -> integer
%import typed.double -> double
%import typed.number -> number
%import typed.string -> string
%import typed.word -> word
%import typed.array -> array
%import typed.record -> record
%import typed.open_close_redirect -> open_close_redirect
%import typed._NL -> _NL
%import typed._remark -> _remark
%import typed.COMMA -> COMMA
%import common.WS_INLINE
%import common.SH_COMMENT

%ignore WS_INLINE
%ignore SH_COMMENT
%ignore COMMA

start: _NL* (block _NL*)*
block: attributes_block | time_block

attributes_block: "begin"i "attributes"i [_remark] _NL _NL* attributes_fields _NL* "end"i "attributes"i
time_block: "begin"i "time"i block_index [_remark] _NL _NL* time_fields _NL* "end"i "time"i [block_index]
block_index: number
attributes_fields: ((time_series_namerecord | interpolation_methodrecord | sfacrecord | open_close_redirect) _NL*)*
time_fields: ((tas_array | open_close_redirect) _NL*)*
time_series_namerecord: "name"i array [_remark] _NL
interpolation_methodrecord: "method"i word [_remark] _NL
sfacrecord: "sfac"i array [_remark] _NL
tas_array: "tas_array"i [_remark] [_NL] array
