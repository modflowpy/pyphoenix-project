// Auto-generated grammar for MF6 OLF-NAM -- see typed.lark's own
// header note for why newlines are significant here.
%import typed.integer -> integer
%import typed.double -> double
%import typed.number -> number
%import typed.string -> string
%import typed.word -> word
%import typed.array -> array
%import typed.record -> record
%import typed.open_close_redirect -> open_close_redirect
%import typed._NL -> _NL
%import typed._remark -> _remark
%import typed.COMMA -> COMMA
%import common.WS_INLINE
%import common.SH_COMMENT
%import typed.BANG_COMMENT -> BANG_COMMENT

%ignore WS_INLINE
%ignore SH_COMMENT
%ignore BANG_COMMENT
%ignore COMMA

start: _NL* (block _NL*)*
block: options__block | packages__block

options__block: "begin"i "options"i [_remark] _NL _NL* options__fields _NL* "end"i "options"i
packages__block: "begin"i "packages"i [_remark] _NL _NL* packages__fields _NL* "end"i "packages"i
options__fields: ((list__val | print_input__kw | print_flows__kw | save_flows__kw | newtonoptions__rec | open_close_redirect) _NL*)*
packages__fields: ((packagesdata | open_close_redirect) _NL*)*
list__val: "list"i string
print_input__kw: "print_input"i  [_remark] _NL
print_flows__kw: "print_flows"i  [_remark] _NL
save_flows__kw: "save_flows"i  [_remark] _NL
newtonoptions__rec: "newton"i [newtonoptions__under_relaxation__kw] [_remark] _NL
newtonoptions__under_relaxation__kw: "under_relaxation"i
packagesdata: record+
