



// Auto-generated grammar for MF6 GWT-IST
%import common.WS
%import common.SH_COMMENT
%import common.NEWLINE

%ignore WS
%ignore SH_COMMENT


// Top-level structure
start: block*
block: options_block | griddata_block
// Block definitions
options_block: "begin"i "options"i options_fields "end"i "options"i
griddata_block: "begin"i "griddata"i griddata_fields "end"i "griddata"i
// Block field lists
options_fields: (cimprintrecord | sorbate_filerecord | export_array_ascii | export_array_netcdf)*
griddata_fields: (porosity | volfrac | zetaim | decay | decay_sorbed | bulk_density | distcoef | sp2)*
// Individual field rules
cimprintrecord: "print_format"i
sorbate_filerecord: "sorbate"i string
export_array_ascii: "export_array_ascii"i 
export_array_netcdf: "export_array_netcdf"i 
porosity: "porosity"i array
volfrac: "volfrac"i array
zetaim: "zetaim"i array
decay: "decay"i array
decay_sorbed: "decay_sorbed"i array
bulk_density: "bulk_density"i array
distcoef: "distcoef"i array
sp2: "sp2"i array
// Recarray rules for period data (stress_period_data, etc.)

// Stress period record: tokens followed by newline, but stop at structural keywords
stress_record: stress_token+ NEWLINE
stress_token: number | _stress_word
_stress_word: /(?!(?i:begin|end|period))[a-zA-Z0-9._'~,-\\(\\)]+/

// Import typed grammar rules
%import typed.integer -> integer
%import typed.double -> double
%import typed.number -> number
%import typed.string -> string
%import typed.simple_string -> simple_string
%import typed.record -> record
%import typed.list -> list
%import typed.array -> array
