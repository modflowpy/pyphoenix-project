// Auto-generated grammar for MF6 PRT-PRP -- see typed.lark's own
// header note for why newlines are significant here.
%import typed.integer -> integer
%import typed.double -> double
%import typed.number -> number
%import typed.string -> string
%import typed.word -> word
%import typed.array -> array
%import typed.record -> record
%import typed.open_close_redirect -> open_close_redirect
%import typed._NL -> _NL
%import typed._remark -> _remark
%import typed.COMMA -> COMMA
%import common.WS_INLINE
%import common.SH_COMMENT

%ignore WS_INLINE
%ignore SH_COMMENT
%ignore COMMA

start: _NL* (block _NL*)*
block: options_block | dimensions_block | packagedata_block | releasetimes_block | period_block

options_block: "begin"i "options"i [_remark] _NL _NL* options_fields _NL* "end"i "options"i
dimensions_block: "begin"i "dimensions"i [_remark] _NL _NL* dimensions_fields _NL* "end"i "dimensions"i
packagedata_block: "begin"i "packagedata"i [_remark] _NL _NL* packagedata_fields _NL* "end"i "packagedata"i
releasetimes_block: "begin"i "releasetimes"i [_remark] _NL _NL* releasetimes_fields _NL* "end"i "releasetimes"i
period_block: "begin"i "period"i block_index [_remark] _NL _NL* period_fields _NL* "end"i "period"i [block_index]
block_index: number
options_fields: ((boundnames | print_input | dev_exit_solve_method | exit_solve_tolerance | local_z | extend_tracking | track_filerecord | trackcsv_filerecord | stoptime | stoptraveltime | stop_at_weak_sink | istopzone | drape | dry_tracking_method | dev_forceternary | release_time_tolerance | release_time_frequency | coordinate_check_method | dev_cycle_detection_window | open_close_redirect) _NL*)*
dimensions_fields: ((nreleasepts | nreleasetimes | open_close_redirect) _NL*)*
packagedata_fields: ((packagedatadata | open_close_redirect) _NL*)*
releasetimes_fields: ((releasetimesdata | open_close_redirect) _NL*)*
period_fields: ((all | first | last | frequency | steps | open_close_redirect) _NL*)*
boundnames: "boundnames"i  [_remark] _NL
print_input: "print_input"i  [_remark] _NL
dev_exit_solve_method: "dev_exit_solve_method"i integer [_remark] _NL
exit_solve_tolerance: "exit_solve_tolerance"i double [_remark] _NL
local_z: "local_z"i  [_remark] _NL
extend_tracking: "extend_tracking"i  [_remark] _NL
track_filerecord: "track"i "fileout"i word [_remark] _NL
trackcsv_filerecord: "trackcsv"i "fileout"i word [_remark] _NL
stoptime: "stoptime"i double [_remark] _NL
stoptraveltime: "stoptraveltime"i double [_remark] _NL
stop_at_weak_sink: "stop_at_weak_sink"i  [_remark] _NL
istopzone: "istopzone"i integer [_remark] _NL
drape: "drape"i  [_remark] _NL
dry_tracking_method: "dry_tracking_method"i (dry_tracking_method_drop | dry_tracking_method_stop | dry_tracking_method_stay) [_remark] _NL

dry_tracking_method_drop: "drop"i
dry_tracking_method_stop: "stop"i
dry_tracking_method_stay: "stay"i

dev_forceternary: "dev_forceternary"i  [_remark] _NL
release_time_tolerance: "release_time_tolerance"i double [_remark] _NL
release_time_frequency: "release_time_frequency"i double [_remark] _NL
coordinate_check_method: "coordinate_check_method"i (coordinate_check_method_none | coordinate_check_method_eager) [_remark] _NL

coordinate_check_method_none: "none"i
coordinate_check_method_eager: "eager"i

dev_cycle_detection_window: "dev_cycle_detection_window"i integer [_remark] _NL
nreleasepts: "nreleasepts"i integer [_remark] _NL
nreleasetimes: "nreleasetimes"i integer [_remark] _NL
all: "all"i  [_remark] _NL
first: "first"i  [_remark] _NL
last: "last"i  [_remark] _NL
frequency: "frequency"i integer [_remark] _NL
steps: "steps"i integer+ [_remark] _NL
packagedatadata: record+
releasetimesdata: record+
