



// Auto-generated grammar for MF6 SIM-TDIS
%import common.WS
%import common.SH_COMMENT
%import common.NEWLINE

%ignore WS
%ignore SH_COMMENT


// Top-level structure
start: block*
block: options_block | dimensions_block | perioddata_block
// Block definitions
options_block: "begin"i "options"i options_fields "end"i "options"i
dimensions_block: "begin"i "dimensions"i dimensions_fields "end"i "dimensions"i
perioddata_block: "begin"i "perioddata"i perioddata_fields "end"i "perioddata"i
// Block field lists
options_fields: (time_units | start_date_time | ats_filerecord)*
dimensions_fields: (nper)*
perioddata_fields: (perioddata)*
// Individual field rules
time_units: "time_units"i string
start_date_time: "start_date_time"i string
ats_filerecord: "ats6"i "filein"i string
nper: "nper"i integer
perioddata: "perioddata"i recarray
// Recarray rules for period data (stress_period_data, etc.)

// Stress period record: tokens followed by newline, but stop at structural keywords
record: token+ NEWLINE
token: number | _word
_word: /(?!(?i:begin|end))[a-zA-Z0-9._'~,-\\(\\)]+/

// Import typed grammar rules
%import typed.integer -> integer
%import typed.double -> double
%import typed.number -> number
%import typed.string -> string
%import typed.array -> array
