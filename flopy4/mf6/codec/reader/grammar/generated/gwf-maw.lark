// Auto-generated grammar for MF6 GWF-MAW

// Newlines are significant here (only inline whitespace is ignored) -- see
// typed.lark's own header note for why: a blanket "%ignore" that swallows
// newlines can't reliably delimit list/record rows or bound a trailing
// per-line remark, since an ignored whitespace run always maximal-munches
// past a bare newline whenever the following line is indented.
%import typed.integer -> integer
%import typed.double -> double
%import typed.number -> number
%import typed.string -> string
%import typed.word -> word
%import typed.array -> array
%import typed.record -> record
%import typed.open_close_redirect -> open_close_redirect
%import typed.unknown_block -> unknown_block
%import typed._NL -> _NL
%import typed._remark -> _remark
%import typed.COMMA -> COMMA
%import common.WS_INLINE
%import common.SH_COMMENT

%ignore WS_INLINE
%ignore SH_COMMENT
%ignore COMMA

start: _NL* (block _NL*)*
block: options_block | dimensions_block | packagedata_block | connectiondata_block | angledata_block | period_block | unknown_block

options_block: "begin"i "options"i [_remark] _NL _NL* options_fields _NL* "end"i "options"i
dimensions_block: "begin"i "dimensions"i [_remark] _NL _NL* dimensions_fields _NL* "end"i "dimensions"i
packagedata_block: "begin"i "packagedata"i [_remark] _NL _NL* packagedata_fields _NL* "end"i "packagedata"i
connectiondata_block: "begin"i "connectiondata"i [_remark] _NL _NL* connectiondata_fields _NL* "end"i "connectiondata"i
angledata_block: "begin"i "angledata"i [_remark] _NL _NL* angledata_fields _NL* "end"i "angledata"i
period_block: "begin"i "period"i block_index [_remark] _NL _NL* period_fields _NL* "end"i "period"i [block_index]
block_index: integer
options_fields: ((auxiliary | boundnames | print_input | print_head | print_flows | save_flows | head_filerecord | budget_filerecord | budgetcsv_filerecord | no_well_storage | flow_correction | non_vertical_wells | flowing_wells | shutdown_theta | shutdown_kappa | mfrcsv_filerecord | ts_filerecord | obs_filerecord | mover | dev_peaceman_effective_radius | open_close_redirect) _NL*)*
dimensions_fields: ((nmawwells | open_close_redirect) _NL*)*
packagedata_fields: ((packagedatadata | open_close_redirect) _NL*)*
connectiondata_fields: ((connectiondatadata | open_close_redirect) _NL*)*
angledata_fields: ((angledatadata | open_close_redirect) _NL*)*
period_fields: ((stress_period_data | open_close_redirect) _NL*)*
auxiliary: "auxiliary"i word+ [_remark] _NL
boundnames: "boundnames"i  [_remark] _NL
print_input: "print_input"i  [_remark] _NL
print_head: "print_head"i  [_remark] _NL
print_flows: "print_flows"i  [_remark] _NL
save_flows: "save_flows"i  [_remark] _NL
head_filerecord: "head"i "fileout"i word [_remark] _NL
budget_filerecord: "budget"i "fileout"i word [_remark] _NL
budgetcsv_filerecord: "budgetcsv"i "fileout"i word [_remark] _NL
no_well_storage: "no_well_storage"i  [_remark] _NL
flow_correction: "flow_correction"i  [_remark] _NL
non_vertical_wells: "non_vertical_wells"i  [_remark] _NL
flowing_wells: "flowing_wells"i  [_remark] _NL
shutdown_theta: "shutdown_theta"i double [_remark] _NL
shutdown_kappa: "shutdown_kappa"i double [_remark] _NL
mfrcsv_filerecord: "maw_flow_reduce_csv"i "fileout"i word [_remark] _NL
ts_filerecord: "ts6"i "filein"i word [_remark] _NL
obs_filerecord: "obs6"i "filein"i word [_remark] _NL
mover: "mover"i  [_remark] _NL
dev_peaceman_effective_radius: "dev_peaceman_effective_radius"i  [_remark] _NL
nmawwells: "nmawwells"i integer [_remark] _NL
packagedatadata: record+
connectiondatadata: record+
angledatadata: record+
stress_period_data: record+
