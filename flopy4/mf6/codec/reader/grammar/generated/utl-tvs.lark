// Auto-generated grammar for MF6 UTL-TVS -- see typed.lark's own
// header note for why newlines are significant here.
%import typed.integer -> integer
%import typed.double -> double
%import typed.number -> number
%import typed.string -> string
%import typed.word -> word
%import typed.array -> array
%import typed.record -> record
%import typed.token_record -> token_record
%import typed.open_close_redirect -> open_close_redirect
%import typed._NL -> _NL
%import typed._remark -> _remark
%import typed._BEGIN -> _BEGIN
%import typed._END -> _END
%import typed.COMMA -> COMMA
%import common.WS_INLINE
%import common.SH_COMMENT
%import typed.BANG_COMMENT -> BANG_COMMENT

%ignore WS_INLINE
%ignore SH_COMMENT
%ignore BANG_COMMENT
%ignore COMMA

start: [_NL] (block [_NL])*
block: options__block | period__block

options__block: _BEGIN "options"i [_remark] _NL options__fields _END "options"i
period__block: _BEGIN "period"i block_index [_remark] _NL period__fields _END "period"i [block_index]
%import typed.block_index -> block_index
options__fields: (disable_storage_change_integration__kw | print_input__kw | ts_filerecord__rec__elem | open_close_redirect _NL)*
period__fields: (stress_period_data | open_close_redirect _NL)*
disable_storage_change_integration__kw: "disable_storage_change_integration"i  [_remark] _NL
print_input__kw: "print_input"i  [_remark] _NL
ts_filerecord__rec__elem: "ts6"i ts_filerecord__ts6_filename__val [_remark] _NL
ts_filerecord__ts6_filename__val: "filein"i word
stress_period_data: record+
