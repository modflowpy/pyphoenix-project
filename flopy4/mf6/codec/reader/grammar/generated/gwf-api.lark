start: _NL* (block _NL*)*
block: options__block | dimensions__block

options__block: _BEGIN "options"i [_remark] _NL _NL* options__fields _NL* _END "options"i
dimensions__block: _BEGIN "dimensions"i [_remark] _NL _NL* dimensions__fields _NL* _END "dimensions"i
options__fields: ((boundnames__kw | print_input__kw | print_flows__kw | save_flows__kw | obs_filerecord__rec | mover__kw | open_close_redirect) _NL*)*
dimensions__fields: ((maxbound__val | open_close_redirect) _NL*)*
boundnames__kw: "boundnames"i  [_remark] _NL
print_input__kw: "print_input"i  [_remark] _NL
print_flows__kw: "print_flows"i  [_remark] _NL
save_flows__kw: "save_flows"i  [_remark] _NL
obs_filerecord__rec: "obs6"i obs_filerecord__obs6_filename__val [_remark] _NL
obs_filerecord__obs6_filename__val: "filein"i word
mover__kw: "mover"i  [_remark] _NL
maxbound__val: "maxbound"i integer [_remark] _NL
