// Auto-generated grammar for MF6 GWT-SSM
%import common.WS
%import common.SH_COMMENT

%ignore WS
%ignore SH_COMMENT

start: block*
block: options_block | fileinput_block
options_block: "begin"i "options"i options_fields "end"i "options"i
fileinput_block: "begin"i "fileinput"i fileinput_fields "end"i "fileinput"i
options_fields: (print_flows | save_flows)*
fileinput_fields: (fileinput)*
