// Auto-generated grammar for MF6 GWT-SSM -- see typed.lark's own
// header note for why newlines are significant here.
%import typed.integer -> integer
%import typed.double -> double
%import typed.number -> number
%import typed.string -> string
%import typed.word -> word
%import typed.array -> array
%import typed.record -> record
%import typed.token_record -> token_record
%import typed.open_close_redirect -> open_close_redirect
%import typed._NL -> _NL
%import typed._remark -> _remark
%import typed._BEGIN -> _BEGIN
%import typed._END -> _END
%import typed.COMMA -> COMMA
%import common.WS_INLINE
%import common.SH_COMMENT
%import typed.BANG_COMMENT -> BANG_COMMENT

%ignore WS_INLINE
%ignore SH_COMMENT
%ignore BANG_COMMENT
%ignore COMMA

start: _NL* (block _NL*)*
block: options__block | sources__block | fileinput__block

options__block: _BEGIN "options"i [_remark] _NL _NL* options__fields _NL* _END "options"i
sources__block: _BEGIN "sources"i [_remark] _NL _NL* sources__fields _NL* _END "sources"i
fileinput__block: _BEGIN "fileinput"i [_remark] _NL _NL* fileinput__fields _NL* _END "fileinput"i
options__fields: ((print_flows__kw | save_flows__kw | open_close_redirect) _NL*)*
sources__fields: ((sourcesdata | open_close_redirect) _NL*)*
fileinput__fields: ((fileinputdata | open_close_redirect) _NL*)*
print_flows__kw: "print_flows"i  [_remark] _NL
save_flows__kw: "save_flows"i  [_remark] _NL
sourcesdata: record+
fileinputdata: record+
