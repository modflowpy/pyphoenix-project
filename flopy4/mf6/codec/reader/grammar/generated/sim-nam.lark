// Auto-generated grammar for MF6 SIM-NAM

// Newlines are significant here (only inline whitespace is ignored) -- see
// typed.lark's own header note for why: a blanket "%ignore" that swallows
// newlines can't reliably delimit list/record rows or bound a trailing
// per-line remark, since an ignored whitespace run always maximal-munches
// past a bare newline whenever the following line is indented.
%import typed.integer -> integer
%import typed.double -> double
%import typed.number -> number
%import typed.string -> string
%import typed.word -> word
%import typed.array -> array
%import typed.record -> record
%import typed._NL -> _NL
%import typed._remark -> _remark
%import common.WS_INLINE
%import common.SH_COMMENT

%ignore WS_INLINE
%ignore SH_COMMENT

start: _NL* (block _NL*)*
block: options_block | timing_block | models_block | exchanges_block | solutiongroup_block
options_block: "begin"i "options"i [_remark] _NL _NL* options_fields _NL* "end"i "options"i
timing_block: "begin"i "timing"i [_remark] _NL _NL* timing_fields _NL* "end"i "timing"i
models_block: "begin"i "models"i [_remark] _NL _NL* models_fields _NL* "end"i "models"i
exchanges_block: "begin"i "exchanges"i [_remark] _NL _NL* exchanges_fields _NL* "end"i "exchanges"i
solutiongroup_block: "begin"i "solutiongroup"i block_index [_remark] _NL _NL* solutiongroup_fields _NL* "end"i "solutiongroup"i [block_index]
block_index: integer
options_fields: ((continue | nocheck | memory_print_option | profile_option | maxerrors | print_input | hpc_filerecord) _NL*)*
timing_fields: ((tdis6) _NL*)*
models_fields: ((modelsdata) _NL*)*
exchanges_fields: ((exchangesdata) _NL*)*
solutiongroup_fields: ((mxiter | solutiongroupdata) _NL*)*
continue: "continue"i  [_remark] _NL
nocheck: "nocheck"i  [_remark] _NL
memory_print_option: "memory_print_option"i string
profile_option: "profile_option"i string
maxerrors: "maxerrors"i integer [_remark] _NL
print_input: "print_input"i  [_remark] _NL
hpc_filerecord: "hpc6"i "filein"i word [_remark] _NL
tdis6: "tdis6"i string
mxiter: "mxiter"i integer [_remark] _NL
modelsdata: record+
exchangesdata: record+
solutiongroupdata: record+
