// Auto-generated grammar for MF6 GWF-STO

// Newlines are significant here (only inline whitespace is ignored) -- see
// typed.lark's own header note for why: a blanket "%ignore" that swallows
// newlines can't reliably delimit list/record rows or bound a trailing
// per-line remark, since an ignored whitespace run always maximal-munches
// past a bare newline whenever the following line is indented.
%import typed.integer -> integer
%import typed.double -> double
%import typed.number -> number
%import typed.string -> string
%import typed.word -> word
%import typed.array -> array
%import typed.record -> record
%import typed.open_close_redirect -> open_close_redirect
%import typed._NL -> _NL
%import typed._remark -> _remark
%import typed.COMMA -> COMMA
%import common.WS_INLINE
%import common.SH_COMMENT

%ignore WS_INLINE
%ignore SH_COMMENT
%ignore COMMA

start: _NL* (block _NL*)*
block: options_block | griddata_block | period_block

options_block: "begin"i "options"i [_remark] _NL _NL* options_fields _NL* "end"i "options"i
griddata_block: "begin"i "griddata"i [_remark] _NL _NL* griddata_fields _NL* "end"i "griddata"i
period_block: "begin"i "period"i block_index [_remark] _NL _NL* period_fields _NL* "end"i "period"i [block_index]
block_index: integer
options_fields: ((save_flows | storagecoefficient | ss_confined_only | tvs_filerecord | export_array_ascii | export_array_netcdf | dev_original_specific_storage | dev_oldstorageformulation | open_close_redirect) _NL*)*
griddata_fields: ((iconvert | ss | sy | open_close_redirect) _NL*)*
period_fields: ((storage | open_close_redirect) _NL*)*
save_flows: "save_flows"i  [_remark] _NL
storagecoefficient: "storagecoefficient"i  [_remark] _NL
ss_confined_only: "ss_confined_only"i  [_remark] _NL
tvs_filerecord: "tvs6"i "filein"i word [_remark] _NL
export_array_ascii: "export_array_ascii"i  [_remark] _NL
export_array_netcdf: "export_array_netcdf"i  [_remark] _NL
dev_original_specific_storage: "dev_original_specific_storage"i  [_remark] _NL
dev_oldstorageformulation: "dev_oldstorageformulation"i  [_remark] _NL
iconvert: "iconvert"i [_remark] [_NL] array
ss: "ss"i [_remark] [_NL] array
sy: "sy"i [_remark] [_NL] array
storage: storage_steady_state | storage_transient [_remark] _NL

storage_steady_state: "steady-state"i
storage_transient: "transient"i

