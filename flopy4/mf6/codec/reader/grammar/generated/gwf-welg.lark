start: _NL* (block _NL*)*
block: options_block | dimensions_block | period_block

options_block: "begin"i "options"i [_remark] _NL _NL* options_fields _NL* "end"i "options"i
dimensions_block: "begin"i "dimensions"i [_remark] _NL _NL* dimensions_fields _NL* "end"i "dimensions"i
period_block: "begin"i "period"i block_index [_remark] _NL _NL* period_fields _NL* "end"i "period"i [block_index]
block_index: integer
options_fields: ((readarraygrid | auxiliary | auxmultname | print_input | print_flows | save_flows | auto_flow_reduce | afrcsv_filerecord | flow_reduction_length | obs_filerecord | mover | export_array_netcdf | open_close_redirect) _NL*)*
