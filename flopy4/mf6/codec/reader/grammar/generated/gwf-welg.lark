period_fields: ((q | aux | open_close_redirect) _NL*)*
readarraygrid: "readarraygrid"i  [_remark] _NL
auxiliary: "auxiliary"i word+ [_remark] _NL
auxmultname: "auxmultname"i string
print_input: "print_input"i  [_remark] _NL
print_flows: "print_flows"i  [_remark] _NL
save_flows: "save_flows"i  [_remark] _NL
auto_flow_reduce: "auto_flow_reduce"i double [_remark] _NL
