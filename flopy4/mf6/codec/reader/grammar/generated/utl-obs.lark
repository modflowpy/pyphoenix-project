// Auto-generated grammar for MF6 UTL-OBS

%import typed.integer -> integer
%import typed.double -> double
%import typed.number -> number
%import typed.string -> string
%import typed.word -> word
%import typed.array -> array
%import typed.record -> record
%import typed.NEWLINE -> NEWLINE
%import common.WS
%import common.SH_COMMENT

%ignore WS
%ignore SH_COMMENT

start: block*
block: options_block | continuous_block
options_block: "begin"i "options"i options_fields "end"i "options"i
continuous_block: "begin"i "continuous"i block_index continuous_fields "end"i "continuous"i block_index
block_index: integer
options_fields: (digits | print_input)*
continuous_fields: (continuousdata)*
digits: "digits"i integer
print_input: "print_input"i 
continuousdata: record+
