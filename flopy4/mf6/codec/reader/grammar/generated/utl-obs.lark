// Auto-generated grammar for MF6 UTL-OBS -- see typed.lark's own
// header note for why newlines are significant here.
%import typed.integer -> integer
%import typed.double -> double
%import typed.number -> number
%import typed.string -> string
%import typed.word -> word
%import typed.array -> array
%import typed.record -> record
%import typed.token_record -> token_record
%import typed.open_close_redirect -> open_close_redirect
%import typed._NL -> _NL
%import typed._remark -> _remark
%import typed._BEGIN -> _BEGIN
%import typed._END -> _END
%import typed.COMMA -> COMMA
%import common.WS_INLINE
%import common.SH_COMMENT
%import typed.BANG_COMMENT -> BANG_COMMENT

%ignore WS_INLINE
%ignore SH_COMMENT
%ignore BANG_COMMENT
%ignore COMMA

start: [_NL] (block [_NL])*
block: options__block | continuous__block

options__block: _BEGIN "options"i [_remark] _NL options__fields _END "options"i
continuous__block: _BEGIN "continuous"i output__hdr [_remark] _NL continuous__fields _END "continuous"i [output__hdr]
!output__hdr: "fileout"i word [output__binary__kw]
output__binary__kw: "binary"i
options__fields: (digits__val | print_input__kw | open_close_redirect _NL)*
continuous__fields: (continuousdata | open_close_redirect _NL)*
digits__val: "digits"i integer [_remark] _NL
print_input__kw: "print_input"i  [_remark] _NL
continuousdata: record+
