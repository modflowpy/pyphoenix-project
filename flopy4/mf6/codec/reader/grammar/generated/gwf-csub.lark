strainib_filerecord: "strain_csv_interbed"i "fileout"i word [_remark] _NL
straincg_filerecord: "strain_csv_coarse"i "fileout"i word [_remark] _NL
compaction_filerecord: "compaction"i "fileout"i word [_remark] _NL
compaction_elastic_filerecord: "compaction_elastic"i "fileout"i word [_remark] _NL
