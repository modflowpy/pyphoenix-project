// Auto-generated grammar for MF6 GWF-CSUB -- see typed.lark's own
// header note for why newlines are significant here.
%import typed.integer -> integer
%import typed.double -> double
%import typed.number -> number
%import typed.string -> string
%import typed.word -> word
%import typed.array -> array
%import typed.record -> record
%import typed.open_close_redirect -> open_close_redirect
%import typed._NL -> _NL
%import typed._remark -> _remark
%import typed.COMMA -> COMMA
%import common.WS_INLINE
%import common.SH_COMMENT

%ignore WS_INLINE
%ignore SH_COMMENT
%ignore COMMA

start: _NL* (block _NL*)*
block: options_block | dimensions_block | griddata_block | packagedata_block | period_block

options_block: "begin"i "options"i [_remark] _NL _NL* options_fields _NL* "end"i "options"i
dimensions_block: "begin"i "dimensions"i [_remark] _NL _NL* dimensions_fields _NL* "end"i "dimensions"i
griddata_block: "begin"i "griddata"i [_remark] _NL _NL* griddata_fields _NL* "end"i "griddata"i
packagedata_block: "begin"i "packagedata"i [_remark] _NL _NL* packagedata_fields _NL* "end"i "packagedata"i
period_block: "begin"i "period"i block_index [_remark] _NL _NL* period_fields _NL* "end"i "period"i [block_index]
block_index: number
options_fields: ((boundnames | print_input | save_flows | gammaw | beta | elastic_inelastic_smoothing | strict_effective_stress | head_based | initial_preconsolidation_head | ndelaycells | compression_indices | update_material_properties | cell_fraction | specified_initial_interbed_state | specified_initial_preconsolidation_stress | specified_initial_delay_head | effective_stress_lag | strainib_filerecord | straincg_filerecord | compaction_filerecord | compaction_elastic_filerecord | compaction_inelastic_filerecord | compaction_interbed_filerecord | compaction_coarse_filerecord | zdisplacement_filerecord | package_convergence_filerecord | ts_filerecord | obs_filerecord | open_close_redirect) _NL*)*
dimensions_fields: ((ninterbeds | maxsig0 | open_close_redirect) _NL*)*
griddata_fields: ((cg_ske_cr | cg_theta | sgm | sgs | open_close_redirect) _NL*)*
packagedata_fields: ((packagedatadata | open_close_redirect) _NL*)*
period_fields: ((stress_period_data | open_close_redirect) _NL*)*
boundnames: "boundnames"i  [_remark] _NL
print_input: "print_input"i  [_remark] _NL
save_flows: "save_flows"i  [_remark] _NL
gammaw: "gammaw"i double [_remark] _NL
beta: "beta"i double [_remark] _NL
elastic_inelastic_smoothing: "elastic_inelastic_smoothing"i  [_remark] _NL
strict_effective_stress: "strict_effective_stress"i  [_remark] _NL
head_based: "head_based"i  [_remark] _NL
initial_preconsolidation_head: "initial_preconsolidation_head"i  [_remark] _NL
ndelaycells: "ndelaycells"i integer [_remark] _NL
compression_indices: "compression_indices"i  [_remark] _NL
update_material_properties: "update_material_properties"i  [_remark] _NL
