// Auto-generated grammar for MF6 GWE-EST

// Newlines are significant here (only inline whitespace is ignored) -- see
// typed.lark's own header note for why: a blanket "%ignore" that swallows
// newlines can't reliably delimit list/record rows or bound a trailing
// per-line remark, since an ignored whitespace run always maximal-munches
// past a bare newline whenever the following line is indented.
%import typed.integer -> integer
%import typed.double -> double
%import typed.number -> number
%import typed.string -> string
%import typed.word -> word
%import typed.array -> array
%import typed.record -> record
%import typed._NL -> _NL
%import typed._remark -> _remark
%import common.WS_INLINE
%import common.SH_COMMENT

%ignore WS_INLINE
%ignore SH_COMMENT

start: _NL* (block _NL*)*
block: options_block | griddata_block
options_block: "begin"i "options"i [_remark] _NL _NL* options_fields _NL* "end"i "options"i
griddata_block: "begin"i "griddata"i [_remark] _NL _NL* griddata_fields _NL* "end"i "griddata"i
options_fields: ((save_flows | zero_order_decay_water | zero_order_decay_solid | density_water | heat_capacity_water | latent_heat_vaporization) _NL*)*
griddata_fields: ((porosity | decay_water | decay_solid | heat_capacity_solid | density_solid) _NL*)*
save_flows: "save_flows"i  [_remark] _NL
zero_order_decay_water: "zero_order_decay_water"i  [_remark] _NL
zero_order_decay_solid: "zero_order_decay_solid"i  [_remark] _NL
density_water: "density_water"i double [_remark] _NL
heat_capacity_water: "heat_capacity_water"i double [_remark] _NL
latent_heat_vaporization: "latent_heat_vaporization"i double [_remark] _NL
porosity: "porosity"i [_remark] [_NL] array
decay_water: "decay_water"i [_remark] [_NL] array
decay_solid: "decay_solid"i [_remark] [_NL] array
heat_capacity_solid: "heat_capacity_solid"i [_remark] [_NL] array
density_solid: "density_solid"i [_remark] [_NL] array
