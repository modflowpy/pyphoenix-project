
// Auto-generated grammar for MF6 GWE-EST
%import common.WS
%import common.SH_COMMENT

%ignore WS
%ignore SH_COMMENT


// Top-level structure
start: block*
block: options_block | griddata_block
// Block definitions
options_block: "begin"i "options"i options_fields "end"i "options"i

griddata_block: "begin"i "griddata"i griddata_fields "end"i "griddata"i

// Block field lists
options_fields: (save_flows | zero_order_decay_water | zero_order_decay_solid | density_water | heat_capacity_water | latent_heat_vaporization)*

griddata_fields: (porosity | decay_water | decay_solid | heat_capacity_solid | density_solid)*

// Individual field rules
save_flows: "save_flows"i 
zero_order_decay_water: "zero_order_decay_water"i 
zero_order_decay_solid: "zero_order_decay_solid"i 
density_water: "density_water"i double
heat_capacity_water: "heat_capacity_water"i double
latent_heat_vaporization: "latent_heat_vaporization"i double
porosity: "porosity"i array
decay_water: "decay_water"i array
decay_solid: "decay_solid"i array
heat_capacity_solid: "heat_capacity_solid"i array
density_solid: "density_solid"i array
// Recarray rules for period data (stress_period_data, etc.)

%import typed.integer -> integer
%import typed.double -> double
%import typed.number -> number
%import typed.string -> string
%import typed.array -> array
%import typed.record -> record
%import typed.NEWLINE -> NEWLINE
