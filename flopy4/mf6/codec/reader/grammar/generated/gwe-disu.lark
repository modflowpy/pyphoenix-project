// Auto-generated grammar for MF6 GWE-DISU

// Newlines are significant here (only inline whitespace is ignored) -- see
// typed.lark's own header note for why: a blanket "%ignore" that swallows
// newlines can't reliably delimit list/record rows or bound a trailing
// per-line remark, since an ignored whitespace run always maximal-munches
// past a bare newline whenever the following line is indented.
%import typed.integer -> integer
%import typed.double -> double
%import typed.number -> number
%import typed.string -> string
%import typed.word -> word
%import typed.array -> array
%import typed.record -> record
%import typed._NL -> _NL
%import typed._remark -> _remark
%import common.WS_INLINE
%import common.SH_COMMENT

%ignore WS_INLINE
%ignore SH_COMMENT

start: _NL* (block _NL*)*
block: options_block | dimensions_block | griddata_block | connectiondata_block | vertices_block | cell2d_block
options_block: "begin"i "options"i [_remark] _NL _NL* options_fields _NL* "end"i "options"i
dimensions_block: "begin"i "dimensions"i [_remark] _NL _NL* dimensions_fields _NL* "end"i "dimensions"i
griddata_block: "begin"i "griddata"i [_remark] _NL _NL* griddata_fields _NL* "end"i "griddata"i
connectiondata_block: "begin"i "connectiondata"i [_remark] _NL _NL* connectiondata_fields _NL* "end"i "connectiondata"i
vertices_block: "begin"i "vertices"i [_remark] _NL _NL* vertices_fields _NL* "end"i "vertices"i
cell2d_block: "begin"i "cell2d"i [_remark] _NL _NL* cell2d_fields _NL* "end"i "cell2d"i
options_fields: ((length_units | nogrb | grb_filerecord | xorigin | yorigin | angrot | vertical_offset_tolerance | export_array_ascii | crs) _NL*)*
dimensions_fields: ((nodes | nja | nvert) _NL*)*
griddata_fields: ((top | bot | area | idomain) _NL*)*
connectiondata_fields: ((iac | ja | ihc | cl12 | hwva | angldegx) _NL*)*
vertices_fields: ((verticesdata) _NL*)*
cell2d_fields: ((cell2ddata) _NL*)*
length_units: "length_units"i string
nogrb: "nogrb"i  [_remark] _NL
grb_filerecord: "grb6"i "fileout"i word [_remark] _NL
xorigin: "xorigin"i double [_remark] _NL
yorigin: "yorigin"i double [_remark] _NL
angrot: "angrot"i double [_remark] _NL
vertical_offset_tolerance: "vertical_offset_tolerance"i double [_remark] _NL
export_array_ascii: "export_array_ascii"i  [_remark] _NL
crs: "crs"i string
nodes: "nodes"i integer [_remark] _NL
nja: "nja"i integer [_remark] _NL
nvert: "nvert"i integer [_remark] _NL
top: "top"i [_remark] [_NL] array
bot: "bot"i [_remark] [_NL] array
area: "area"i [_remark] [_NL] array
idomain: "idomain"i [_remark] [_NL] array
iac: "iac"i [_remark] [_NL] array
ja: "ja"i [_remark] [_NL] array
ihc: "ihc"i [_remark] [_NL] array
cl12: "cl12"i [_remark] [_NL] array
hwva: "hwva"i [_remark] [_NL] array
angldegx: "angldegx"i [_remark] [_NL] array
verticesdata: record+
cell2ddata: record+
