// Auto-generated grammar for MF6 UTL-TS -- see typed.lark's own
// header note for why newlines are significant here.
%import typed.integer -> integer
%import typed.double -> double
%import typed.number -> number
%import typed.string -> string
%import typed.word -> word
%import typed.array -> array
%import typed.record -> record
%import typed.open_close_redirect -> open_close_redirect
%import typed._NL -> _NL
%import typed._remark -> _remark
%import typed.COMMA -> COMMA
%import common.WS_INLINE
%import common.SH_COMMENT

%ignore WS_INLINE
%ignore SH_COMMENT
%ignore COMMA

start: _NL* (block _NL*)*
block: attributes_block | timeseries_block

attributes_block: "begin"i "attributes"i [_remark] _NL _NL* attributes_fields _NL* "end"i "attributes"i
timeseries_block: "begin"i "timeseries"i [_remark] _NL _NL* timeseries_fields _NL* "end"i "timeseries"i
attributes_fields: ((time_series_namerecord | interpolation_methodrecord | interpolation_methodrecord_single | sfacrecord | sfacrecord_single | open_close_redirect) _NL*)*
timeseries_fields: ((timeseriesdata | open_close_redirect) _NL*)*
time_series_namerecord: "names"i word+ [_remark] _NL
interpolation_methodrecord: "methods"i word+ [_remark] _NL
interpolation_methodrecord_single: "method"i word [_remark] _NL
sfacrecord: "sfacs"i double+ [_remark] _NL
sfacrecord_single: "sfac"i double [_remark] _NL
timeseriesdata: record+
