// Auto-generated grammar for MF6 UTL-TS

// Newlines are significant here (only inline whitespace is ignored) -- see
// typed.lark's own header note for why: a blanket "%ignore" that swallows
// newlines can't reliably delimit list/record rows or bound a trailing
// per-line remark, since an ignored whitespace run always maximal-munches
// past a bare newline whenever the following line is indented.
%import typed.integer -> integer
%import typed.double -> double
%import typed.number -> number
%import typed.string -> string
%import typed.word -> word
%import typed.array -> array
%import typed.record -> record
%import typed.open_close_redirect -> open_close_redirect
%import typed._NL -> _NL
%import typed._remark -> _remark
%import typed.COMMA -> COMMA
%import common.WS_INLINE
%import common.SH_COMMENT

%ignore WS_INLINE
%ignore SH_COMMENT
%ignore COMMA

start: _NL* (block _NL*)*
block: attributes_block | timeseries_block

attributes_block: "begin"i "attributes"i [_remark] _NL _NL* attributes_fields _NL* "end"i "attributes"i
timeseries_block: "begin"i "timeseries"i [_remark] _NL _NL* timeseries_fields _NL* "end"i "timeseries"i
attributes_fields: ((time_series_namerecord | interpolation_methodrecord | interpolation_methodrecord_single | method | interpolation_method_single | sfacrecord | sfacrecord_single | sfac | open_close_redirect) _NL*)*
timeseries_fields: ((timeseriesdata | open_close_redirect) _NL*)*
time_series_namerecord: "names"i array [_remark] _NL
interpolation_methodrecord: "methods"i array [_remark] _NL
interpolation_methodrecord_single:  [_remark] _NL
method: "method"i  [_remark] _NL
interpolation_method_single: "interpolation_method_single"i (interpolation_method_single_stepwise | interpolation_method_single_linear | interpolation_method_single_linearend) [_remark] _NL

interpolation_method_single_stepwise: "stepwise"i
interpolation_method_single_linear: "linear"i
interpolation_method_single_linearend: "linearend"i

sfacrecord: "sfacs"i array [_remark] _NL
sfacrecord_single: array [_remark] _NL
sfac: "sfac"i  [_remark] _NL
timeseriesdata: record+
