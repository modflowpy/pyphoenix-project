
// Auto-generated grammar for MF6 SWF-NAM
%import common.WS
%import common.SH_COMMENT

%ignore WS
%ignore SH_COMMENT


// Top-level structure
start: block*
block: options_block | packages_block
// Block definitions
options_block: "begin"i "options"i options_fields "end"i "options"i

packages_block: "begin"i "packages"i packages_fields "end"i "packages"i

// Block field lists
options_fields: (list | print_input | print_flows | save_flows | newtonoptions)*

packages_fields: (packages)*

// Individual field rules
list: "list"i string
print_input: "print_input"i 
print_flows: "print_flows"i 
save_flows: "save_flows"i 
newtonoptions: "newton"i "under_relaxation"i
packages: "packages"i recarray
// Recarray rules for period data (stress_period_data, etc.)

%import typed.integer -> integer
%import typed.double -> double
%import typed.number -> number
%import typed.string -> string
%import typed.array -> array
%import typed.record -> record
%import typed.NEWLINE -> NEWLINE
