start: _NL* (block _NL*)*
block: options__block | dimensions__block | tracktimes__block | period__block

options__block: _BEGIN "options"i [_remark] _NL _NL* options__fields _NL* _END "options"i
dimensions__block: _BEGIN "dimensions"i [_remark] _NL _NL* dimensions__fields _NL* _END "dimensions"i
tracktimes__block: _BEGIN "tracktimes"i [_remark] _NL _NL* tracktimes__fields _NL* _END "tracktimes"i
