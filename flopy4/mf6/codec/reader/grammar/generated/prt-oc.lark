dimensions_block: "begin"i "dimensions"i dimensions_fields "end"i "dimensions"i
period_block: "begin"i "period"i period_fields "end"i "period"i
tracktimes_block: "begin"i "tracktimes"i tracktimes_fields "end"i "tracktimes"i
options_fields: (budget_filerecord | budgetcsv_filerecord | track_filerecord | trackcsv_filerecord | track_release | track_exit | track_timestep | track_terminate | track_weaksink | track_usertime | track_timesrecord | track_timesfilerecord | dev_dump_event_trace)*
