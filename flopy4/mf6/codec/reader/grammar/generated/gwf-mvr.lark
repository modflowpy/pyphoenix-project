// Auto-generated grammar for MF6 GWF-MVR -- see typed.lark's own
// header note for why newlines are significant here.
%import typed.integer -> integer
%import typed.double -> double
%import typed.number -> number
%import typed.string -> string
%import typed.word -> word
%import typed.array -> array
%import typed.record -> record
%import typed.open_close_redirect -> open_close_redirect
%import typed._NL -> _NL
%import typed._remark -> _remark
%import typed.COMMA -> COMMA
%import common.WS_INLINE
%import common.SH_COMMENT
%import typed.BANG_COMMENT -> BANG_COMMENT

%ignore WS_INLINE
%ignore SH_COMMENT
%ignore BANG_COMMENT
%ignore COMMA

start: _NL* (block _NL*)*
block: options__block | dimensions__block | packages__block | period__block

options__block: "begin"i "options"i [_remark] _NL _NL* options__fields _NL* "end"i "options"i
dimensions__block: "begin"i "dimensions"i [_remark] _NL _NL* dimensions__fields _NL* "end"i "dimensions"i
packages__block: "begin"i "packages"i [_remark] _NL _NL* packages__fields _NL* "end"i "packages"i
period__block: "begin"i "period"i block_index [_remark] _NL _NL* period__fields _NL* "end"i "period"i [block_index]
%import typed.block_index -> block_index
options__fields: ((print_input__kw | print_flows__kw | modelnames__kw | budget_filerecord__rec | budgetcsv_filerecord__rec | open_close_redirect) _NL*)*
dimensions__fields: ((maxmvr__val | maxpackages__val | open_close_redirect) _NL*)*
packages__fields: ((packagesdata | open_close_redirect) _NL*)*
period__fields: ((stress_period_data | open_close_redirect) _NL*)*
print_input__kw: "print_input"i  [_remark] _NL
print_flows__kw: "print_flows"i  [_remark] _NL
modelnames__kw: "modelnames"i  [_remark] _NL
budget_filerecord__rec: "budget"i budget_filerecord__budgetfile__val [_remark] _NL
budget_filerecord__budgetfile__val: "fileout"i word
budgetcsv_filerecord__rec: "budgetcsv"i budgetcsv_filerecord__budgetcsvfile__val [_remark] _NL
budgetcsv_filerecord__budgetcsvfile__val: "fileout"i word
maxmvr__val: "maxmvr"i integer [_remark] _NL
maxpackages__val: "maxpackages"i integer [_remark] _NL
packagesdata: record+
stress_period_data: record+
