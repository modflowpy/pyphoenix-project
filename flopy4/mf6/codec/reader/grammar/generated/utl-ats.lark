
// Auto-generated grammar for MF6 UTL-ATS
%import common.WS
%import common.SH_COMMENT

%ignore WS
%ignore SH_COMMENT


// Top-level structure
start: block*
block: dimensions_block | perioddata_block
// Block definitions
dimensions_block: "begin"i "dimensions"i dimensions_fields "end"i "dimensions"i

perioddata_block: "begin"i "perioddata"i perioddata_fields "end"i "perioddata"i

// Block field lists
dimensions_fields: (maxats)*

perioddata_fields: (perioddata)*

// Individual field rules
maxats: "maxats"i integer
perioddata: "perioddata"i recarray
// Recarray rules for period data (stress_period_data, etc.)

%import typed.integer -> integer
%import typed.double -> double
%import typed.number -> number
%import typed.string -> string
%import typed.array -> array
%import typed.record -> record
%import typed.NEWLINE -> NEWLINE
