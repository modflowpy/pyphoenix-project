// Auto-generated grammar for MF6 CHF-CXS -- see typed.lark's own
// header note for why newlines are significant here.
%import typed.integer -> integer
%import typed.double -> double
%import typed.number -> number
%import typed.string -> string
%import typed.word -> word
%import typed.array -> array
%import typed.record -> record
%import typed.open_close_redirect -> open_close_redirect
%import typed._NL -> _NL
%import typed._remark -> _remark
%import typed.COMMA -> COMMA
%import common.WS_INLINE
%import common.SH_COMMENT
%import typed.BANG_COMMENT -> BANG_COMMENT

%ignore WS_INLINE
%ignore SH_COMMENT
%ignore BANG_COMMENT
%ignore COMMA

start: _NL* (block _NL*)*
block: options__block | dimensions__block | packagedata__block | crosssectiondata__block

options__block: "begin"i "options"i [_remark] _NL _NL* options__fields _NL* "end"i "options"i
dimensions__block: "begin"i "dimensions"i [_remark] _NL _NL* dimensions__fields _NL* "end"i "dimensions"i
packagedata__block: "begin"i "packagedata"i [_remark] _NL _NL* packagedata__fields _NL* "end"i "packagedata"i
crosssectiondata__block: "begin"i "crosssectiondata"i [_remark] _NL _NL* crosssectiondata__fields _NL* "end"i "crosssectiondata"i
options__fields: ((print_input__kw | open_close_redirect) _NL*)*
dimensions__fields: ((nsections__val | npoints__val | open_close_redirect) _NL*)*
packagedata__fields: ((packagedatadata | open_close_redirect) _NL*)*
crosssectiondata__fields: ((crosssectiondatadata | open_close_redirect) _NL*)*
print_input__kw: "print_input"i  [_remark] _NL
nsections__val: "nsections"i integer [_remark] _NL
npoints__val: "npoints"i integer [_remark] _NL
packagedatadata: record+
crosssectiondatadata: record+
