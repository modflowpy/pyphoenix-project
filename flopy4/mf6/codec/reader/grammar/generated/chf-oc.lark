// Auto-generated grammar for MF6 CHF-OC -- see typed.lark's own
// header note for why newlines are significant here.
%import typed.integer -> integer
%import typed.double -> double
%import typed.number -> number
%import typed.string -> string
%import typed.word -> word
%import typed.array -> array
%import typed.record -> record
%import typed.token_record -> token_record
%import typed.open_close_redirect -> open_close_redirect
%import typed._NL -> _NL
%import typed._remark -> _remark
%import typed._BEGIN -> _BEGIN
%import typed._END -> _END
%import typed.COMMA -> COMMA
%import common.WS_INLINE
%import common.SH_COMMENT
%import typed.BANG_COMMENT -> BANG_COMMENT

%ignore WS_INLINE
%ignore SH_COMMENT
%ignore BANG_COMMENT
%ignore COMMA

start: [_NL] (block [_NL])*
block: options__block | period__block

options__block: _BEGIN "options"i [_remark] _NL options__fields _END "options"i
period__block: _BEGIN "period"i block_index [_remark] _NL period__fields _END "period"i [block_index]
%import typed.block_index -> block_index
options__fields: (budget_filerecord__rec | budgetcsv_filerecord__rec | qoutflow_filerecord__rec | stage_filerecord__rec | qoutflowprintrecord__rec | open_close_redirect _NL)*
period__fields: (saverecord__rec__elem | printrecord__rec__elem | open_close_redirect _NL)*
budget_filerecord__rec: "budget"i budget_filerecord__budgetfile__val [_remark] _NL
budget_filerecord__budgetfile__val: "fileout"i word
budgetcsv_filerecord__rec: "budgetcsv"i budgetcsv_filerecord__budgetcsvfile__val [_remark] _NL
budgetcsv_filerecord__budgetcsvfile__val: "fileout"i word
qoutflow_filerecord__rec: "qoutflow"i qoutflow_filerecord__qoutflowfile__val [_remark] _NL
qoutflow_filerecord__qoutflowfile__val: "fileout"i word
stage_filerecord__rec: "stage"i stage_filerecord__stagefile__val [_remark] _NL
stage_filerecord__stagefile__val: "fileout"i word
qoutflowprintrecord__rec: "qoutflow"i "print_format"i formatrecord__rec [_remark] _NL
saverecord__rec__elem: "save"i saverecord__rtype__val ocsetting__union [_remark] _NL
saverecord__rtype__val: word
printrecord__rec__elem: "print"i printrecord__rtype__val ocsetting__union [_remark] _NL
printrecord__rtype__val: word
formatrecord__rec: [formatrecord__columns__val] [formatrecord__width__val] [formatrecord__digits__val] formatrecord__format__val
formatrecord__columns__val: "columns"i integer
formatrecord__width__val: "width"i integer
formatrecord__digits__val: "digits"i integer
formatrecord__format__val: word
ocsetting__union: ocsetting__all__kw | ocsetting__first__kw | ocsetting__last__kw | ocsetting__frequency__val | ocsetting__steps__val

!ocsetting__all__kw: "all"i
!ocsetting__first__kw: "first"i
!ocsetting__last__kw: "last"i
ocsetting__frequency__val: "frequency"i integer
ocsetting__steps__val: "steps"i integer+
