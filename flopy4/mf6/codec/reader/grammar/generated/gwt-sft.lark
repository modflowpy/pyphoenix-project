%ignore WS_INLINE
%ignore SH_COMMENT
%ignore BANG_COMMENT
%ignore COMMA

start: _NL* (block _NL*)*
block: options__block | packagedata__block | period__block

options__block: _BEGIN "options"i [_remark] _NL _NL* options__fields _NL* _END "options"i
packagedata__block: _BEGIN "packagedata"i [_remark] _NL _NL* packagedata__fields _NL* _END "packagedata"i
period__block: _BEGIN "period"i block_index [_remark] _NL _NL* period__fields _NL* _END "period"i [block_index]
%import typed.block_index -> block_index
options__fields: ((flow_package_name__val | auxiliary__val | flow_package_auxiliary_name__val | boundnames__kw | print_input__kw | print_concentration__kw | print_flows__kw | save_flows__kw | concentration_filerecord__rec | budget_filerecord__rec | budgetcsv_filerecord__rec | ts_filerecord__rec__elem | obs_filerecord__rec | dev_nonexpanding_matrix__kw | open_close_redirect) _NL*)*
packagedata__fields: ((packagedatadata | open_close_redirect) _NL*)*
period__fields: ((stress_period_data | open_close_redirect) _NL*)*
flow_package_name__val: "flow_package_name"i string
