



// Auto-generated grammar for MF6 GWF-LAK
%import common.WS
%import common.SH_COMMENT
%import common.NEWLINE

%ignore WS
%ignore SH_COMMENT


// Top-level structure
start: block*
block: options_block | dimensions_block | period_block | tables_block | connectiondata_block | outlets_block
// Block definitions
options_block: "begin"i "options"i options_fields "end"i "options"i
dimensions_block: "begin"i "dimensions"i dimensions_fields "end"i "dimensions"i
period_block: "begin"i "period"i block_index period_fields "end"i "period"i block_index
tables_block: "begin"i "tables"i tables_fields "end"i "tables"i
connectiondata_block: "begin"i "connectiondata"i connectiondata_fields "end"i "connectiondata"i
outlets_block: "begin"i "outlets"i outlets_fields "end"i "outlets"i
block_index: integer
// Block field lists
options_fields: (obs_filerecord | mover | surfdep | maximum_iterations | maximum_stage_change | time_conversion | length_conversion)*
dimensions_fields: (nlakes | noutlets | ntables)*
period_fields: ()*
tables_fields: (tables)*
connectiondata_fields: (connectiondata)*
outlets_fields: (outlets)*
// Individual field rules
obs_filerecord: "obs6"i string
mover: "mover"i 
surfdep: "surfdep"i double
maximum_iterations: "maximum_iterations"i integer
maximum_stage_change: "maximum_stage_change"i double
time_conversion: "time_conversion"i double
length_conversion: "length_conversion"i double
nlakes: "nlakes"i integer
noutlets: "noutlets"i integer
ntables: "ntables"i integer
tables: "tables"i recarray
connectiondata: "connectiondata"i recarray
outlets: "outlets"i recarray
// Recarray rules for period data (stress_period_data, etc.)

// Stress period record: tokens followed by newline, but stop at structural keywords
record: token+ NEWLINE
token: number | _word
_word: /(?!(?i:begin|end))[a-zA-Z0-9._'~,-\\(\\)]+/

// Import typed grammar rules
%import typed.integer -> integer
%import typed.double -> double
%import typed.number -> number
%import typed.string -> string
%import typed.array -> array
