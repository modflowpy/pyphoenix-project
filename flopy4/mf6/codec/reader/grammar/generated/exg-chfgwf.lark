
// Auto-generated grammar for MF6 EXG-CHFGWF
%import common.WS
%import common.SH_COMMENT

%ignore WS
%ignore SH_COMMENT

// Top-level structure
start: block*
block: options_block | dimensions_block | exchangedata_block
// Block definitions
options_block: "begin"i "options"i options_fields "end"i "options"i

dimensions_block: "begin"i "dimensions"i dimensions_fields "end"i "dimensions"i

exchangedata_block: "begin"i "exchangedata"i exchangedata_fields "end"i "exchangedata"i

// Block field lists
options_fields: (print_input | print_flows | fixed_conductance | obs_filerecord)*

dimensions_fields: (nexg)*

exchangedata_fields: (exchangedata)*

// Individual field rules
print_input: "print_input"i 
print_flows: "print_flows"i 
fixed_conductance: "fixed_conductance"i 
obs_filerecord: "obs6"i "filein"i string
nexg: "nexg"i integer
exchangedata: "exchangedata"i recarray
// Recarray rules for period data (stress_period_data, etc.)

%import typed.integer -> integer
%import typed.double -> double
%import typed.number -> number
%import typed.string -> string
%import typed.array -> array
%import typed.record -> record
%import typed.NEWLINE -> NEWLINE
